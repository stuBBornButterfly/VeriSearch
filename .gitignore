# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environments
.venv/
venv/
.env
.env.*
!.env.example

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Project artifacts (large, regenerated, never committed)
data/raw/
data/processed/
# Smoke builds (`prepare-data --limit N`). Never data, never committed.
data/smoke/
# Where scripts/01_build_index.sh writes. `*.faiss` below catches the HNSW
# graph but not doc_ids.json beside it, nor a brute-force index's vectors.npy
# (1.4 GB on the full corpus).
data/index/
indexes/
checkpoints/
outputs/
wandb/
results/raw/*
!results/raw/.gitkeep
results/figures/*
!results/figures/.gitkeep
# ...except the one figure writeup/report.md embeds. Section 2 requires the
# report to be published with its plots, and a figure that is gitignored renders
# for its author and nobody else. The table behind it is results/frontier.md,
# which is not under an ignored path.
!results/figures/frontier.png

# Model weights
*.bin
*.safetensors
*.pt
*.faiss

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
