# Copy to .env and fill in. .env is gitignored - never commit real keys.

# Weights & Biases (PROJECT.md section 5: runs are public)
WANDB_API_KEY=
WANDB_PROJECT=verisearch
WANDB_ENTITY=

# Hugging Face (model + dataset downloads)
HF_TOKEN=
HF_HOME=

# Overrides for configs/base.yaml. Prefix VERISEARCH_, nested keys joined by
# a double underscore, and these beat the YAML. A variable that does not match
# a field in verisearch/config.py is silently ignored - the name has to be exact.
VERISEARCH_RETRIEVAL__SERVICE_URL=http://127.0.0.1:8000
